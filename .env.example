# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO NORTHFLANK / HOSTING
# ==========================================

# Môi trường chạy (đặt là production trên Northflank)
NODE_ENV=production

# Cổng lắng nghe (Northflank tự động map hoặc đặt là 3000)
PORT=3000

# Chuỗi kết nối MongoDB (Tạo qua Northflank Addon MongoDB hoặc MongoDB Atlas)
# Ví dụ: mongodb+srv://<user>:<password>@cluster0.mongodb.net/journal_app?retryWrites=true&w=majority
MONGODB_URI=

# Khóa bí mật dùng để mã hóa JWT token đăng nhập (Chuỗi ngẫu nhiên dài từ 32 ký tự trở lên)
JWT_SECRET=super-secret-jwt-key-replace-with-a-random-string

# API Key cho Google Gemini (Tính năng AI Thấu cảm / Gợi ý tâm trạng)
GEMINI_API_KEY=

# URL public của ứng dụng sau khi deploy lên Northflank (Ví dụ: https://my-app.code.northflank.app)
APP_URL=
